{
  "name": "oracle-sql",
  "version": "1.3.0",
  "description": "連線 Oracle 資料庫並執行 SQL 指令，查詢結果以表格顯示；也能接收其他工具分享的 SQL（tooldock.sql）",
  "main": "backend/index.js",
  "private": true,
  "scripts": {
    "dev": "tooldock-ext dev",
    "debug": "tooldock-ext dev --inspect",
    "validate": "tooldock-ext validate",
    "test": "node --test test/*.test.js",
    "pack": "tooldock-ext pack",
    "install-local": "tooldock-ext install"
  },
  "tooldock": {
    "id": "oracle-sql",
    "displayName": "Oracle SQL 工具",
    "description": "連線 Oracle 並執行 SQL：最多同時 5 條連線切換使用、:參數綁定、資料表瀏覽、記住密碼（鑰匙圈加密）、SQL 保存；接收其他工具分享的 SQL，預覽、試跑、確認後執行並回傳結果",
    "icon": "🛢",
    "engine": "^1.4.0",
    "activationEvents": [],
    "keepAlive": true,
    "contributes": {
      "views": [
        {
          "id": "oracleSql.main",
          "title": "Oracle SQL",
          "icon": "🛢",
          "entry": "ui/index.html"
        }
      ],
      "commands": [
        {
          "id": "oracleSql.open",
          "title": "Oracle SQL：開啟"
        },
        {
          "id": "oracleSql.disconnect",
          "title": "Oracle SQL：中斷全部連線"
        }
      ],
      "configuration": {
        "oracleSql.maxRows": {
          "type": "number",
          "default": 500,
          "title": "最多顯示列數",
          "description": "查詢結果最多取回的列數，超過會標示並截斷"
        },
        "oracleSql.callTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "title": "執行逾時（秒）",
          "description": "單一指令超過此時間會被中止"
        },
        "oracleSql.autoCommit": {
          "type": "boolean",
          "default": false,
          "title": "自動提交",
          "description": "關閉時，INSERT / UPDATE / DELETE 需手動按 Commit"
        },
        "oracleSql.exchangeMaxRows": {
          "type": "number",
          "default": 10000,
          "title": "交換：查詢預設回傳列數",
          "description": "其他工具分享的 SQL 沒有指定 maxRows 時，每次查詢最多回傳的列數（上限 100000）"
        }
      },
      "exchange": {
        "imports": [
          {
            "type": "tooldock.sql",
            "minVersion": 1,
            "maxVersion": 1,
            "handler": "importSql",
            "title": "在 Oracle 執行",
            "view": "oracleSql.main"
          }
        ]
      },
      "lifecycle": {
        "app:before-quit": "onBeforeQuit"
      }
    }
  },
  "dependencies": {
    "oracledb": "^26.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tooldock-cli": "^1.1.0",
    "tooldock-types": "^1.1.0"
  },
  "keywords": [
    "tooldock",
    "oracle",
    "sql",
    "exchange",
    "tooldock.sql"
  ]
}
